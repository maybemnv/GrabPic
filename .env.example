# === Convex database ===
# Run `pnpm --filter @grabpic/api convex:dev` for a local deployment.
# Use the generated deployment URL for CONVEX_URL.
CONVEX_URL=
CONVEX_SERVICE_SECRET=

# === Cloudflare R2 (Photo Storage) ===
# Create R2 bucket: wrangler r2 bucket create grabpic-photos
# Generate API keys from Cloudflare Dashboard > R2 > Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=grabpic-photos
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# === Cloudflare Workers (API Deployment) ===
# Get from Cloudflare Dashboard > API Tokens
CLOUDFLARE_API_TOKEN=

# === OCI CPU processor behind Nginx ===
# Store OCI secrets in /etc/grabpic/processor.env and Worker secrets in Wrangler
PROCESSOR_TOKEN=
PROCESSOR_CALLBACK_TOKEN=
WORKER_CALLBACK_URL=http://localhost:8787/internal/processor/results
PROCESSOR_WEBHOOK_URL=
PROCESSOR_CANCEL_URL=
PROCESSOR_EMBEDDING_URL=
PROCESSOR_DB_PATH=/var/lib/grabpic/jobs.sqlite3
MATCH_THRESHOLD=0.6

# === API Base URL ===
# Use http://localhost:8787 for local dev with wrangler dev
# Use the deployed Worker URL for production
API_BASE_URL=http://localhost:8787

# === Frontend ===
# Next.js public env var for API URL (client-side accessible)
NEXT_PUBLIC_API_URL=http://localhost:8787

# === Monitoring & Analytics (Optional) ===
SENTRY_DSN=
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# === JWT Secret (Future: Organizer Auth) ===
JWT_SECRET=
