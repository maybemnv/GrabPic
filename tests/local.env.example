# Local-only infrastructure test switch. Do not use this file for deployment.
RUN_REAL_INFRA_TESTS=1
API_BASE_URL=http://127.0.0.1:8787

# The Worker uses the local Convex deployment created by `convex dev`.
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SERVICE_SECRET=local-test-secret

# Fill these only when running the real R2/OCI processor path locally.
PROCESSOR_TOKEN=
PROCESSOR_CALLBACK_TOKEN=
PROCESSOR_WEBHOOK_URL=
PROCESSOR_CANCEL_URL=
PROCESSOR_EMBEDDING_URL=
